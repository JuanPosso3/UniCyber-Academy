# URL base de la API.
#
# Por defecto se usa /api y Vite lo reenvía a http://localhost:3000
# durante el desarrollo. En un despliegue separado, define la URL
# completa del backend, por ejemplo:
# VITE_API_BASE_URL="https://api.example.com/api"
#
# VITE_API_BASE_URL="/api"

# Clave pública de reCAPTCHA v2 Checkbox. Configurar en Vercel antes del build.
VITE_RECAPTCHA_SITE_KEY=""
# VITE_API_URL ya puede existir en el despliegue; este cliente conserva
# VITE_API_BASE_URL o /api (proxy de Vercel) para mantener cookies del mismo origen.
# VITE_API_URL="https://backend.example.com"
