# Copy this file to `.env` and replace the placeholders.

# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign JWT access tokens.
# Generate a random value of at least 32 characters and never commit it.
# Example (PowerShell):
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Minimum 0 -Maximum 16) })
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Token/session lifetime. Accepted: 3600, 30m, 2h, 7d.
JWT_EXPIRES_IN="2h"

# Cookies are always HttpOnly and SameSite=Lax. `Secure` is enabled
# automatically when NODE_ENV=production. Set COOKIE_SECURE=true to
# force it in another HTTPS environment.
# COOKIE_SECURE="true"
