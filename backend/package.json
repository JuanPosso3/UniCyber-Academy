{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter unicyber-web dev",
    "build": "tsc",
    "build:web": "pnpm --filter unicyber-web build",
    "build:all": "pnpm build && pnpm build:web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:web": "pnpm --filter unicyber-web typecheck",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:web",
    "test": "tsx --test test/course-management.test.ts",
    "start": "node dist/server.js",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "prisma": "8.0.0-rc.15",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
