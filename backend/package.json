{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter unicyber-web dev",
    "build": "tsc",
    "build:web": "pnpm --filter unicyber-web build",
    "build:all": "pnpm build && pnpm build:web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:web": "pnpm --filter unicyber-web typecheck",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:web",
    "test": "tsx --test --test-concurrency=1 test/course-management.test.ts test/lesson-learning.test.ts test/assessment.test.ts test/gamification.test.ts test/user-account.test.ts test/admin-dashboard.test.ts test/registration-policy.test.ts test/registration-http.test.ts",
    "test:security": "tsx --test test/security.test.ts",
    "test:recaptcha": "tsx --test test/recaptcha.test.ts test/login-recaptcha.test.ts",
    "test:recovery": "tsx --test test/google-apps-script.test.ts test/password-recovery.test.ts",
    "test:security:integration": "tsx --test test/security-integration.test.ts",
    "test:security:browser:fixture": "tsx test/browser-security.fixture.ts",
    "seed:academic": "tsx src/prisma/seed-academic-content.ts",
    "rate-limit:init": "tsx src/prisma/init-rate-limit-store.ts",
    "start": "node dist/server.js",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "db:check": "prisma migration check",
    "db:verify": "prisma db verify",
    "db:migrate": "prisma db migrate",
    "db:status": "prisma db migrate --show"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "prisma": "8.0.0-rc.15",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
